MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# URL pública del backend — usada como notification_url en las preferencias de MP.
# DEBE ser una URL accesible desde internet (no localhost) para que MP entregue los webhooks.
APP_BACKEND_URL=
MAIL_USERNAME=
MAIL_PASSWORD=
# Orígenes permitidos por CORS — lista separada por comas, soporta wildcards.
# Si no se define, se usan los valores por defecto del application.properties.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://*.devtunnels.ms